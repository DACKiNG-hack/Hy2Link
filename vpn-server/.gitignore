# ============================================================
# 安全审计 S2：以下文件包含真实凭据/私钥，绝不能进入版本控制
#   server.json        -> obfsPassword（Salamander PSK，明文）
#   users.json         -> 全局密码明文、管理员口令哈希、用户口令明文
#   cert.json          -> 证书配置（ACME 域名/邮箱）
#   certs/             -> 自签证书私钥（泄露 = 可被完整中间人）
#   logs/  *.log       -> 客户端用户名、真实 IP、虚拟 IP
# ============================================================
users.json
server.json
cert.json
certs/

# 运行期产物
logs/
*.log
error.log

# 本地调试用的配置副本
*.json.bak
*.json.tmp
users.json.tmp
server.json.tmp
cert.json.tmp

# 二进制与构建产物
*.exe
*.syso
*.dll
Hy2link-server

# 运行期释放的 wintun.dll 由 wintun_embed.go 自动释放，无需入库
wintun.dll

# 编辑器/系统
.idea/
.vscode/
Thumbs.db
desktop.ini
.DS_Store
